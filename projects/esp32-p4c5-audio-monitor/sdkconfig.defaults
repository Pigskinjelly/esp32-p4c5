# ESP32-P4C5 远程音频监控 demo 默认配置
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# ---- 音频（esp_codec_dev 内置 ES8311）----
CONFIG_CODEC_ES8311_SUPPORT=y
# ---- Web 服务 WebSocket（推流音频给浏览器）----
CONFIG_HTTPD_WS_SUPPORT=y

# ---- ESP-Hosted：协处理器 = ESP32-C5（Wi-Fi 由 C5 通过 SDIO 提供）----
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
# esp_wifi_remote 的 slave target（默认是 C6，必须显式设为 C5）
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
# 不选择任何"开发板"预设（保持 ESP_HOSTED_P4_DEV_BOARD_NONE），
# SDIO 引脚显式设为 ESP32-P4C5-Core 核心板内部连接（C5<->P4）：
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
