#include "nvs.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/idf_additions.h"
#include "freertos/semphr.h"

#include "lvgl.h"
#include "ui_shell.h"
#include "esp_lvgl_port.h"
#include "ui_theme.h"
#include "wifi_mgr.h"
#include "bt_mgr.h"

static const char *TAG = "ui_map";

#define MAP_W       480
#define MAP_H       480
#define ZOOM_MIN    3
#define ZOOM_MAX    18
#define CELL_BASE   110.0          /* zoom=11 时一个街区的像素 */

#define RGB565(r, g, b) ((uint16_t)((((r) & 0xF8) << 8) | (((g) & 0xFC) << 3) | ((b) >> 3)))

/* 配色（与设计稿一致） */
#define C_MAP_BG    RGB565(0x10, 0x18, 0x27)
#define C_MAP_ROAD  RGB565(0x2A, 0x37, 0x50)
#define C_MAP_MAIN  RGB565(0x3A, 0x4A, 0x6A)
#define C_ROUTE     RGB565(0x3B, 0x82, 0xF6)
#define C_ME        RGB565(0x2D, 0xD4, 0xBF)
#define C_PIN       RGB565(0xF8, 0x71, 0x71)

/* ================= 状态 ================= */
static double s_lat = 22.5431;      /* 深圳，未定位时的占位 */
static double s_lon = 114.0579;
static bool   s_have_fix;
static char   s_place[32] = "--";
static int    s_zoom = 11;
static bool   s_ble_fix;
static bool   s_manual_fix;

/* 视窗：屏幕左上角对应的世界坐标（像素） */
static double s_pan_x, s_pan_y;
static double s_cell = CELL_BASE;

/* 目的地（世界坐标）与名称 */
static double s_dest_wx, s_dest_wy;
static bool   s_dest_set;
static char   s_dest_name[40] = "";
static char   s_start_name[40] = "";

static int    s_route_dist_m, s_route_dur_s;
static volatile int  s_route_state;     /* 0 无 1 成功 2 找不到地点 */
static volatile bool s_nav_on;
static volatile bool s_geo_warn;     /* 地点没解析出来（只给示意路线） */

/* 网络任务 */
static SemaphoreHandle_t s_sem;
static volatile bool s_need_fix;
static volatile bool s_need_route;
static char   s_req_start[40], s_req_end[40];

/* 画布 */
static uint8_t *s_base_buf;         /* 静态层 */
static uint8_t *s_view_buf;         /* 显示层 = 静态层 + 动画 */
static lv_image_dsc_t s_view_dsc;
static lv_obj_t *s_img;
static lv_obj_t *s_lbl_info;
static volatile bool s_map_dirty;

/* 动画 */
static lv_timer_t *s_anim;
static float s_anim_phase;

/* UI */
static lv_obj_t *s_nav_ov;
static lv_obj_t *s_calib_ov;
static lv_obj_t *s_calib_in;
static char s_calib_inp[40];

static lv_obj_t *s_nav_start_lbl;
static lv_obj_t *s_nav_end_lbl;
static char s_nav_start_buf[40];
static char s_nav_end_buf[40];
static int  s_nav_active;           /* 0 起点 1 终点 */

/* ================= 手动校准（NVS） ================= */
static bool load_calib(double *lat, double *lon)
{
    nvs_handle_t h;
    int32_t a = 0, b = 0;
    bool ok = false;
    if (nvs_open("sys", NVS_READONLY, &h) == ESP_OK) {
        if (nvs_get_i32(h, "map_lat", &a) == ESP_OK && nvs_get_i32(h, "map_lon", &b) == ESP_OK) {
            *lat = a / 1e6;
            *lon = b / 1e6;
            ok = true;
        }
        nvs_close(h);
    }
    return ok;
}

static void save_calib(double lat, double lon)
{
    nvs_handle_t h;
    if (nvs_open("sys", NVS_READWRITE, &h) == ESP_OK) {
        nvs_set_i32(h, "map_lat", (int32_t)(lat * 1e6));
        nvs_set_i32(h, "map_lon", (int32_t)(lon * 1e6));
        nvs_commit(h);
        nvs_close(h);
    }
}

/* ================= 绘制基础 ================= */
static inline void px(uint16_t *buf, int x, int y, uint16_t c)
{
    if (x < 0 || x >= MAP_W || y < 0 || y >= MAP_H) {
        return;
    }
    buf[(size_t)y * MAP_W + x] = c;
}

static void rect_fill(uint16_t *buf, int x, int y, int w, int h, uint16_t c)
{
    if (x < 0) {
        w += x;
        x = 0;
    }
    if (y < 0) {
        h += y;
        y = 0;
    }
    if (x + w > MAP_W) {
        w = MAP_W - x;
    }
    if (y + h > MAP_H) {
        h = MAP_H - y;
    }
    if (w <= 0 || h <= 0) {
        return;
    }
    for (int r = 0; r < h; r++) {
        uint16_t *row = buf + (size_t)(y + r) * MAP_W + x;
        for (int i = 0; i < w; i++) {
            row[i] = c;
        }
    }
}

static void line_w(uint16_t *buf, int x0, int y0, int x1, int y1, int w, uint16_t c)
{
    int dx = abs(x1 - x0), sx = x0 < x1 ? 1 : -1;
    int dy = -abs(y1 - y0), sy = y0 < y1 ? 1 : -1;
    int err = dx + dy;
    int h = w / 2;
    for (;;) {
        rect_fill(buf, x0 - h, y0 - h, w, w, c);
        if (x0 == x1 && y0 == y1) {
            break;
        }
        int e2 = 2 * err;
        if (e2 >= dy) { err += dy; x0 += sx; }
        if (e2 <= dx) { err += dx; y0 += sy; }
    }
}

static void circle_fill(uint16_t *buf, int cx, int cy, int r, uint16_t c)
{
    for (int y = -r; y <= r; y++) {
        for (int x = -r; x <= r; x++) {
            if (x * x + y * y <= r * r) {
                px(buf, cx + x, cy + y, c);
            }
        }
    }
}

static void ring(uint16_t *buf, int cx, int cy, int r_in, int r_out, uint16_t c)
{
    int r2i = r_in * r_in, r2o = r_out * r_out;
    for (int y = -r_out; y <= r_out; y++) {
        for (int x = -r_out; x <= r_out; x++) {
            int d = x * x + y * y;
            if (d >= r2i && d <= r2o) {
                px(buf, cx + x, cy + y, c);
            }
        }
    }
}

static inline int wx2sx(double wx) { return (int)(wx - s_pan_x); }
static inline int wy2sy(double wy) { return (int)(wy - s_pan_y); }

/* 格点抖动：同一个 i 永远一样，平移时不闪 */
static uint32_t hash32(uint32_t x)
{
    x ^= x >> 16;
    x *= 0x7feb352dU;
    x ^= x >> 15;
    x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}

static void draw_roads(uint16_t *buf)
{
    double cell = s_cell;
    if (cell < 24) {
        cell = 24;
    }
    int i0 = (int)floor(s_pan_x / cell) - 1;
    int i1 = (int)floor((s_pan_x + MAP_W) / cell) + 1;
    for (int i = i0; i <= i1; i++) {
        int jitter = (int)(hash32((uint32_t)i ^ 0x9E3779B9u) % 17) - 8;
        int x = (int)(i * cell - s_pan_x) + jitter;
        bool main = ((i & 3) == 0);
        line_w(buf, x, 0, x, MAP_H - 1, main ? 9 : 5, main ? C_MAP_MAIN : C_MAP_ROAD);
    }
    int j0 = (int)floor(s_pan_y / cell) - 1;
    int j1 = (int)floor((s_pan_y + MAP_H) / cell) + 1;
    for (int j = j0; j <= j1; j++) {
        int jitter = (int)(hash32((uint32_t)j ^ 0x85EBCA6Bu) % 17) - 8;
        int y = (int)(j * cell - s_pan_y) + jitter;
        bool main = ((j & 3) == 2);
        line_w(buf, 0, y, MAP_W - 1, y, main ? 9 : 5, main ? C_MAP_MAIN : C_MAP_ROAD);
    }
    /* 两条斜向主干道（世界坐标固定，平移/缩放跟着走） */
    for (int k = -2; k <= 2; k++) {
        double base = (double)k * cell * 3.0;
        int x0 = wx2sx(base) - 200;
        int y0 = wy2sy(base) - 200;
        line_w(buf, x0, y0, x0 + MAP_W + 400, y0 + (MAP_H + 400) * 2 / 5, 9, C_MAP_MAIN);
        int x1 = wx2sx(base) + 260;
        line_w(buf, x1, y0, x1 - (MAP_W + 400), y0 + (MAP_H + 400) * 2 / 5, 5, C_MAP_ROAD);
    }
}

/* 路线折线（屏幕坐标，正交梯级） */
static int route_points(int *xs, int *ys, int max)
{
    int cx = MAP_W / 2, cy = MAP_H / 2;
    int dx = wx2sx(s_dest_wx);
    int dy = wy2sy(s_dest_wy);
    if (max < 6) {
        return 0;
    }
    int vdir = (dy < cy) ? -1 : 1;
    int span = abs(dy - cy);
    int h1 = span / 3 + 16;
    int h2 = span / 4 + 10;
    int mx = cx + (dx - cx) / 2;

    xs[0] = cx;  ys[0] = cy;
    xs[1] = cx;  ys[1] = cy + vdir * h1;
    xs[2] = mx;  ys[2] = cy + vdir * h1;
    xs[3] = mx;  ys[3] = dy - vdir * h2;
    xs[4] = dx;  ys[4] = dy - vdir * h2;
    xs[5] = dx;  ys[5] = dy;
    return 6;
}

static void draw_route(uint16_t *buf)
{
    int xs[8], ys[8];
    int n = route_points(xs, ys, 8);
    for (int i = 0; i + 1 < n; i++) {
        line_w(buf, xs[i], ys[i], xs[i + 1], ys[i + 1], 6, C_ROUTE);
    }
}

/* 终点 pin：圆头 + 尖尾 + 白点 */
static void draw_pin(uint16_t *buf, int x, int y)
{
    circle_fill(buf, x, y - 9, 9, C_PIN);
    for (int oy = -5; oy <= 3; oy++) {
        int half = (oy < 0) ? (8 + oy) : (8 - oy * 2);
        if (half < 0) {
            half = 0;
        }
        rect_fill(buf, x - half, y + oy, half * 2 + 1, 1, C_PIN);
    }
    circle_fill(buf, x, y - 9, 3, 0xFFFF);
}

/* 重建静态层 */
static void map_rebuild(void)
{
    if (!s_base_buf || !s_view_buf) {
        return;
    }
    uint16_t *b = (uint16_t *)s_base_buf;
    rect_fill(b, 0, 0, MAP_W, MAP_H, C_MAP_BG);
    draw_roads(b);

    if (s_nav_on) {
        draw_route(b);
    }
    if (s_dest_set) {
        draw_pin(b, wx2sx(s_dest_wx), wy2sy(s_dest_wy));
    }
    /* 我的位置：白圈 + 青点 */
    circle_fill(b, MAP_W / 2, MAP_H / 2, 10, 0xFFFF);
    circle_fill(b, MAP_W / 2, MAP_H / 2, 6, C_ME);

    s_map_dirty = true;
}

/* 沿折线取 t（0~1）处的点 */
static void route_point_at(float t, int *ox, int *oy)
{
    int xs[8], ys[8];
    int n = route_points(xs, ys, 8);
    if (n < 2) {
        *ox = MAP_W / 2;
        *oy = MAP_H / 2;
        return;
    }
    float seg[8];
    float total = 0;
    for (int i = 0; i + 1 < n; i++) {
        float ddx = (float)(xs[i + 1] - xs[i]);
        float ddy = (float)(ys[i + 1] - ys[i]);
        seg[i] = sqrtf(ddx * ddx + ddy * ddy);
        total += seg[i];
    }
    if (total <= 0.01f) {
        *ox = xs[0];
        *oy = ys[0];
        return;
    }
    float want = t * total;
    for (int i = 0; i + 1 < n; i++) {
        if (want <= seg[i] || i == n - 2) {
            float f = seg[i] > 0.01f ? want / seg[i] : 0;
            if (f > 1) {
                f = 1;
            }
            *ox = (int)(xs[i] + (xs[i + 1] - xs[i]) * f);
            *oy = (int)(ys[i] + (ys[i + 1] - ys[i]) * f);
            return;
        }
        want -= seg[i];
    }
}

/* 每帧：静态层 + 动画 */
static void map_frame(void)
{
    if (!s_base_buf || !s_view_buf || !s_img) {
        return;
    }
    memcpy(s_view_buf, s_base_buf, (size_t)MAP_W * MAP_H * 2);
    uint16_t *v = (uint16_t *)s_view_buf;

    int cx = MAP_W / 2, cy = MAP_H / 2;

    /* 我的位置呼吸环 */
    float br = 13.0f + 4.0f * sinf(s_anim_phase * 6.28318f);
    ring(v, cx, cy, (int)br, (int)br + 2, C_ME);

    /* 路线上循环移动的光点 */
    if (s_nav_on) {
        int ppx, ppy;
        route_point_at(fmodf(s_anim_phase, 1.0f), &ppx, &ppy);
        circle_fill(v, ppx, ppy, 4, 0xFFFF);
        circle_fill(v, ppx, ppy, 2, C_ROUTE);
    }
    /* 终点呼吸光圈 */
    if (s_dest_set) {
        int dx = wx2sx(s_dest_wx), dy = wy2sy(s_dest_wy);
        float pr = 11.0f + 5.0f * sinf(s_anim_phase * 6.28318f);
        ring(v, dx, dy - 9, (int)pr, (int)pr + 2, C_PIN);
    }

    lv_obj_invalidate(s_img);
}

static void anim_cb(lv_timer_t *t)
{
    (void)t;
    s_anim_phase += 0.012f;
    if (s_anim_phase > 1.0f) {
        s_anim_phase -= 1.0f;
    }
    if (s_map_dirty) {
        s_map_dirty = false;
        map_rebuild();
    }
    if (s_img && !lv_obj_has_flag(s_img, LV_OBJ_FLAG_HIDDEN)) {
        map_frame();
    }
}

/* ================= 网络：IP 定位 / 地理编码 / 路线 ================= */
static int http_get(const char *url, char *buf, int cap, bool https)
{
    esp_http_client_config_t cfg = {
        .url = url,
        .timeout_ms = 9000,
        .buffer_size = 2048,
        .user_agent = "ESP32-P4C5/2.34 (map demo)",
    };
    if (https) {
        cfg.crt_bundle_attach = esp_crt_bundle_attach;
    }
    esp_http_client_handle_t cli = esp_http_client_init(&cfg);
    if (!cli) {
        return -1;
    }
    int total = -1;
    if (esp_http_client_open(cli, 0) == ESP_OK) {
        esp_http_client_fetch_headers(cli);
        int status = esp_http_client_get_status_code(cli);
        total = 0;
        while (total < cap - 1) {
            int r = esp_http_client_read(cli, buf + total, cap - 1 - total);
            if (r <= 0) {
                break;
            }
            total += r;
        }
        buf[total] = 0;
        if (status != 200) {
            ESP_LOGW(TAG, "GET %s -> http %d", url, status);
            total = -1;
        }
    } else {
        ESP_LOGW(TAG, "GET %s failed", url);
    }
    esp_http_client_close(cli);
    esp_http_client_cleanup(cli);
    return total;
}

/* ip-api.com：城市级定位 */
static int fetch_ip_location(char *place, size_t place_len)
{
    char *buf = heap_caps_malloc(2048, MALLOC_CAP_SPIRAM);
    if (!buf) {
        return -1;
    }
    int n = http_get("http://ip-api.com/json/?lang=zh-CN&fields=status,lat,lon,city",
                     buf, 2048, false);
    int ok = -1;
    if (n > 0 && !strstr(buf, "\"fail\"")) {
        const char *la = strstr(buf, "\"lat\":");
        const char *lo = strstr(buf, "\"lon\":");
        const char *ci = strstr(buf, "\"city\":\"");
        if (la && lo) {
            double a = strtod(la + 6, NULL);
            double b = strtod(lo + 6, NULL);
            if (a != 0.0 && b != 0.0) {
                s_lat = a;
                s_lon = b;
                if (ci) {
                    const char *e = strchr(ci + 8, '"');
                    if (e) {
                        size_t len = (size_t)(e - (ci + 8));
                        if (len >= place_len) {
                            len = place_len - 1;
                        }
                        memcpy(place, ci + 8, len);
                        place[len] = 0;
                    }
                }
                ok = 0;
            }
        }
    }
    heap_caps_free(buf);
    return ok;
}

/* 百分号编码（中文按 UTF-8 字节） */
static void url_encode(const char *s, char *out, size_t cap)
{
    static const char *hex = "0123456789ABCDEF";
    size_t o = 0;
    for (const unsigned char *p = (const unsigned char *)s; *p && o + 4 < cap; p++) {
        if (isalnum(*p) || *p == '-' || *p == '_' || *p == '.' || *p == '~') {
            out[o++] = (char)*p;
        } else {
            out[o++] = '%';
            out[o++] = hex[*p >> 4];
            out[o++] = hex[*p & 0x0F];
        }
    }
    out[o] = 0;
}

/* 地点名 → 经纬度；也接受 "纬度,经度" */
static bool geocode(const char *q, double *lat, double *lon)
{
    double a = 0, b = 0;
    if (sscanf(q, "%lf,%lf", &a, &b) == 2 && fabs(a) <= 90.0 && fabs(b) <= 180.0 &&
        !(a == 0.0 && b == 0.0)) {
        *lat = a;
        *lon = b;
        return true;
    }
    char enc[160];
    url_encode(q, enc, sizeof(enc));
    char url[360];
    snprintf(url, sizeof(url),
             "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1"
             "&accept-language=zh&q=%s", enc);
    char *buf = heap_caps_malloc(4096, MALLOC_CAP_SPIRAM);
    if (!buf) {
        return false;
    }
    int n = http_get(url, buf, 4096, true);
    bool ok = false;
    *lat = 0;
    *lon = 0;
    if (n > 0) {
        const char *la = strstr(buf, "\"lat\":\"");
        const char *lo = strstr(buf, "\"lon\":\"");
        if (la && lo) {
            a = strtod(la + 7, NULL);
            b = strtod(lo + 7, NULL);
            if (fabs(a) <= 90.0 && fabs(b) <= 180.0 && !(a == 0 && b == 0)) {
                *lat = a;
                *lon = b;
                ok = true;
            }
        }
    }
    ESP_LOGI(TAG, "geocode \"%s\" -> %d (%.5f,%.5f)", q, ok ? 1 : 0, *lat, *lon);
    heap_caps_free(buf);
    return ok;
}

/* OSRM：只要里程/时长 */
static bool fetch_route(double lat1, double lon1, double lat2, double lon2)
{
    char url[256];
    snprintf(url, sizeof(url),
             "http://router.project-osrm.org/route/v1/driving/%.6f,%.6f;%.6f,%.6f?overview=false",
             lon1, lat1, lon2, lat2);
    static char *rx;
    if (!rx) {
        rx = heap_caps_malloc(4096, MALLOC_CAP_SPIRAM);
    }
    if (!rx) {
        return false;
    }
    int n = http_get(url, rx, 4096, false);
    bool ok = false;
    if (n > 0) {
        const char *d = strstr(rx, "\"distance\":");
        const char *t = strstr(rx, "\"duration\":");
        if (d && t) {
            s_route_dist_m = (int)strtod(d + 11, NULL);
            s_route_dur_s = (int)strtod(t + 11, NULL);
            ok = (s_route_dist_m > 0);
        }
    }
    ESP_LOGI(TAG, "route -> %s (%d m / %d s)", ok ? "ok" : "fail",
             s_route_dist_m, s_route_dur_s);
    return ok;
}

static void map_task(void *arg)
{
    (void)arg;
    while (1) {
        if (xSemaphoreTake(s_sem, portMAX_DELAY) != pdTRUE) {
            continue;
        }
        if (wifi_mgr_get_state() != WIFI_MGR_CONNECTED) {
            s_need_fix = s_need_route = false;
            continue;
        }
        if (s_need_fix) {
            s_need_fix = false;
            char place[32] = { 0 };
            if (fetch_ip_location(place, sizeof(place)) == 0) {
                s_have_fix = true;
                if (place[0]) {
                    strlcpy(s_place, place, sizeof(s_place));
                }
                ESP_LOGI(TAG, "ip location: %.5f,%.5f (%s)", s_lat, s_lon, s_place);
            } else {
                ESP_LOGW(TAG, "ip location failed");
            }
        }
        if (s_need_route) {
            s_need_route = false;
            char start[40], end[40];
            strlcpy(start, s_req_start, sizeof(start));
            strlcpy(end, s_req_end, sizeof(end));

            double slat = s_lat, slon = s_lon;
            bool start_ok = false;
            if (!start[0] || strcmp(start, "我的位置") == 0 || strcmp(start, "当前位置") == 0) {
                start_ok = s_have_fix;
            } else {
                start_ok = geocode(start, &slat, &slon);
            }
            double dlat = 0, dlon = 0;
            bool dest_ok = (end[0] != 0) && geocode(end, &dlat, &dlon);

            s_route_dist_m = 0;
            s_route_dur_s = 0;
            if (dest_ok && start_ok) {
                fetch_route(slat, slon, dlat, dlon);
            }
            /* 地图本身是示意的：解析不出来也照样画路线，只是没有里程 */
            s_route_state = 1;
            s_geo_warn = (!dest_ok || !start_ok);
            s_dest_set = true;
            s_nav_on = true;
            s_map_dirty = true;
            ESP_LOGI(TAG, "plan done: dest_ok=%d start_ok=%d dist=%d", (int)dest_ok,
                     (int)start_ok, s_route_dist_m);
        }
    }
}

static void request(bool fix, bool route)
{
    if (fix) {
        s_need_fix = true;
    }
    if (route) {
        s_need_route = true;
    }
    if (s_sem) {
        xSemaphoreGive(s_sem);
    }
}

/* 蓝牙收到手机位置 */
static void on_ble_loc(double lat, double lon)
{
    s_lat = lat;
    s_lon = lon;
    s_have_fix = true;
    s_ble_fix = true;
    strlcpy(s_place, "手机定位", sizeof(s_place));
}

/* ================= 弹窗：起点 / 终点 ================= */
static void nav_field_paint(void)
{
    if (s_nav_start_lbl) {
        lv_label_set_text(s_nav_start_lbl,
                          s_nav_start_buf[0] ? ui_font_safe(s_nav_start_buf, &ui_cjk_16) : "我的位置");
        lv_obj_set_style_text_color(s_nav_start_lbl,
                                    col(s_nav_active == 0 ? 0xFFFFFF : 0x8A93A6), 0);
    }
    if (s_nav_end_lbl) {
        lv_label_set_text(s_nav_end_lbl,
                          s_nav_end_buf[0] ? ui_font_safe(s_nav_end_buf, &ui_cjk_16) : "输入目的地");
        lv_obj_set_style_text_color(s_nav_end_lbl,
                                    col(s_nav_active == 1 ? 0xFFFFFF : 0x8A93A6), 0);
    }
}

static void nav_bind_active(void)
{
    if (s_nav_active == 0) {
        ui_keypad_bind(s_nav_start_buf, sizeof(s_nav_start_buf), s_nav_start_lbl,
                       nav_field_paint, NULL);
    } else {
        ui_keypad_bind(s_nav_end_buf, sizeof(s_nav_end_buf), s_nav_end_lbl,
                       nav_field_paint, NULL);
    }
    nav_field_paint();
}

static void nav_field_cb(lv_event_t *e)
{
    s_nav_active = (int)(intptr_t)lv_event_get_user_data(e);
    nav_bind_active();
}

static void nav_cancel_cb(lv_event_t *e)
{
    (void)e;
    if (s_nav_ov) {
        lv_obj_add_flag(s_nav_ov, LV_OBJ_FLAG_HIDDEN);
    }
}

static void nav_start_cb(lv_event_t *e)
{
    (void)e;
    if (!s_nav_end_buf[0]) {
        s_nav_active = 1;
        nav_bind_active();
        ui_shell_toast("请先输入目的地");
        return;
    }
    if (s_nav_ov) {
        lv_obj_add_flag(s_nav_ov, LV_OBJ_FLAG_HIDDEN);
    }
    strlcpy(s_req_start, s_nav_start_buf[0] ? s_nav_start_buf : "我的位置", sizeof(s_req_start));
    strlcpy(s_req_end, s_nav_end_buf, sizeof(s_req_end));
    strlcpy(s_start_name, s_req_start, sizeof(s_start_name));
    strlcpy(s_dest_name, s_req_end, sizeof(s_dest_name));

    s_route_state = 0;
    s_nav_on = false;
    /* 终点先放到屏幕右上方（世界坐标），路线形状基于它 */
    s_dest_wx = s_pan_x + MAP_W / 2 + 120;
    s_dest_wy = s_pan_y + MAP_H / 2 - 150;
    s_dest_set = true;
    s_map_dirty = true;
    ui_shell_toast("正在规划路线…");
    request(false, true);
}

static void nav_open_cb(void)
{
    if (!s_nav_ov) {
        return;
    }
    s_nav_active = 1;
    nav_bind_active();
    lv_obj_remove_flag(s_nav_ov, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(s_nav_ov);
}

