    lv_obj_set_width(s_nav_end_lbl, 350);
    lv_label_set_long_mode(s_nav_end_lbl, LV_LABEL_LONG_DOT);

    lv_obj_t *hint = ui_label(card, "可输地点名，或 纬度,经度", &ui_cjk_16, 0x5E6B85);
    lv_obj_set_pos(hint, 16, 148);

    lv_obj_t *go = lv_button_create(card);
    lv_obj_set_size(go, 206, 44);
    lv_obj_set_pos(go, 16, 178);
    lv_obj_set_style_radius(go, 12, 0);
    lv_obj_set_style_bg_color(go, col(0x8B5CF6), 0);
