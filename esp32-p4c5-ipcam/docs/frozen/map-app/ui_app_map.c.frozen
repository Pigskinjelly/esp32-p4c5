/* ================= 校准浮层 ================= */
static void calib_cancel_cb(lv_event_t *e)
{
    (void)e;
    lv_obj_add_flag(s_calib_ov, LV_OBJ_FLAG_HIDDEN);
}

static void calib_ok_cb(lv_event_t *e)
{
    (void)e;
    double lat = 0, lon = 0;
    if (sscanf(s_calib_inp, "%lf,%lf", &lat, &lon) != 2) {
        ui_shell_toast("请按 纬度,经度 格式输入");
        return;
    }
    if (lat < -90.0 || lat > 90.0 || lon < -180.0 || lon > 180.0 ||
        (lat == 0.0 && lon == 0.0)) {
        ui_shell_toast("经纬度不合法");
        return;
    }
    s_lat = lat;
    s_lon = lon;
    s_have_fix = true;
    s_manual_fix = true;
    s_ble_fix = false;
    strlcpy(s_place, "我的位置", sizeof(s_place));
    save_calib(lat, lon);
    lv_obj_add_flag(s_calib_ov, LV_OBJ_FLAG_HIDDEN);
    ui_shell_toast("已按经纬度校准");
}

static void calib_open_cb(lv_event_t *e)
{
    (void)e;
    s_calib_inp[0] = 0;
    if (s_calib_in) {
        lv_label_set_text(s_calib_in, "");
    }
    lv_obj_remove_flag(s_calib_ov, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(s_calib_ov);
    ui_keypad_bind(s_calib_inp, sizeof(s_calib_inp), s_calib_in, NULL, NULL);
}

