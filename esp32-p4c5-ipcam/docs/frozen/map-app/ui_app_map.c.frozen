/* ================= 交互 ================= */
static void zoom_cb(lv_event_t *e)
{
    int d = (int)(intptr_t)lv_event_get_user_data(e);
    int z = s_zoom + d;
    if (z < ZOOM_MIN) z = ZOOM_MIN;
    if (z > ZOOM_MAX) z = ZOOM_MAX;
    if (z == s_zoom) {
        return;
    }
    s_zoom = z;
    s_cell = CELL_BASE * pow(2.0, (s_zoom - 11) / 2.0);
    s_map_dirty = true;
}

static void locate_cb(lv_event_t *e)
{
    (void)e;
    ui_shell_toast("正在定位…");
    request(true, false);
}

/* 拖动地图 */
static bool s_pan_ok;
static int s_drag_dx, s_drag_dy;

static void map_pressed_cb(lv_event_t *e)
{
    (void)e;
    lv_indev_t *indev = lv_indev_active();
    if (!indev) {
        s_pan_ok = false;
        return;
    }
    lv_point_t p;
    lv_indev_get_point(indev, &p);
    s_pan_ok = (p.x > 44 && p.x < MAP_W - 44 && p.y > 44 && p.y < MAP_H - 44);
}

static void map_released_cb(lv_event_t *e)
{
    (void)e;
    if (s_drag_dx || s_drag_dy) {
        s_drag_dx = s_drag_dy = 0;
        lv_obj_set_pos(s_img, 0, 0);
        s_map_dirty = true;
    }
}

static void map_pressing_cb(lv_event_t *e)
{
    (void)e;
    if (!s_pan_ok) {
        return;
    }
    lv_indev_t *indev = lv_indev_active();
    if (!indev) {
        return;
    }
    lv_point_t v;
    lv_indev_get_vect(indev, &v);
    if (v.x == 0 && v.y == 0) {
        return;
    }
    s_drag_dx -= v.x;
    s_drag_dy -= v.y;
    lv_obj_set_pos(s_img, s_drag_dx, s_drag_dy);
    if (s_drag_dx >= 100 || s_drag_dx <= -100 || s_drag_dy >= 100 || s_drag_dy <= -100) {
        s_pan_x -= s_drag_dx;      /* 画面往左移 = 视窗往右走 */
        s_pan_y -= s_drag_dy;
        s_drag_dx = s_drag_dy = 0;
        lv_obj_set_pos(s_img, 0, 0);
        s_map_dirty = true;
    }
}

/* 左下按钮：点=规划路线（起点/终点弹窗），长按=重新定位 */
static void nav_main_cb(lv_event_t *e)
{
    (void)e;
    nav_open_cb();
}

static void nav_long_cb(lv_event_t *e)
{
    (void)e;
    if (s_dest_set) {
        s_dest_set = false;
        s_nav_on = false;
        s_route_state = 0;
        s_route_dist_m = 0;
        s_dest_name[0] = 0;
        s_map_dirty = true;
        ui_shell_toast("已清除路线");
        return;
    }
    locate_cb(e);
}

static lv_obj_t *float_btn(lv_obj_t *parent, const char *txt, int x, int y, int w, int h,
                           int radius, uint32_t bg, uint32_t fg, const lv_font_t *font,
                           lv_event_cb_t cb, void *ud)
{
    lv_obj_t *b = lv_button_create(parent);
    lv_obj_set_size(b, w, h);
    lv_obj_set_pos(b, x, y);
    lv_obj_set_style_radius(b, radius, 0);
    lv_obj_set_style_bg_color(b, col(bg), 0);
    lv_obj_set_style_bg_opa(b, 240, 0);
    lv_obj_set_style_pad_all(b, 0, 0);
    lv_obj_set_style_shadow_width(b, 0, 0);
    if (cb) {
        lv_obj_add_event_cb(b, cb, LV_EVENT_CLICKED, ud);
    }
    lv_obj_t *l = ui_label(b, txt, font ? font : &ui_cjk_16, fg);
    lv_obj_center(l);
    return b;
}

static void reset_ui_refs(void)
{
    s_lbl_info = NULL;
    s_img = NULL;
    s_nav_ov = NULL;
    s_nav_start_lbl = NULL;
    s_nav_end_lbl = NULL;
    s_calib_ov = NULL;
    s_calib_in = NULL;
}

static void create(lv_obj_t *parent)
{
    reset_ui_refs();
    if (!s_base_buf) {
        s_base_buf = heap_caps_aligned_alloc(64, MAP_W * MAP_H * 2, MALLOC_CAP_SPIRAM);
        s_view_buf = heap_caps_aligned_alloc(64, MAP_W * MAP_H * 2, MALLOC_CAP_SPIRAM);
    }
    if (!s_base_buf || !s_view_buf) {
        ui_shell_toast("内存不足，地图无法启动");
        return;
    }
    memset(s_view_buf, 0, MAP_W * MAP_H * 2);

    memset(&s_view_dsc, 0, sizeof(s_view_dsc));
    s_view_dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
    s_view_dsc.header.cf = LV_COLOR_FORMAT_RGB565;
    s_view_dsc.header.w = MAP_W;
    s_view_dsc.header.h = MAP_H;
    s_view_dsc.header.stride = MAP_W * 2;
    s_view_dsc.data = s_view_buf;
    s_view_dsc.data_size = MAP_W * MAP_H * 2;

    s_img = lv_image_create(parent);
    lv_image_set_src(s_img, &s_view_dsc);
    lv_obj_set_pos(s_img, 0, 0);
    lv_obj_add_flag(s_img, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_event_cb(s_img, map_pressed_cb, LV_EVENT_PRESSED, NULL);
    lv_obj_add_event_cb(s_img, map_released_cb, LV_EVENT_RELEASED, NULL);
    lv_obj_add_event_cb(s_img, map_pressing_cb, LV_EVENT_PRESSING, NULL);

    /* 顶部胶囊：里程·时间 / 状态 */
    lv_obj_t *pill = lv_obj_create(parent);
    lv_obj_set_size(pill, 250, 36);
    lv_obj_set_pos(pill, 8, 8);
    lv_obj_set_style_bg_color(pill, col(0x0A0D14), 0);
    lv_obj_set_style_bg_opa(pill, 235, 0);
    lv_obj_set_style_border_width(pill, 0, 0);
    lv_obj_set_style_radius(pill, 18, 0);
    lv_obj_set_style_pad_all(pill, 0, 0);
    lv_obj_clear_flag(pill, LV_OBJ_FLAG_SCROLLABLE);
    s_lbl_info = ui_label(pill, "定位中…", &ui_cjk_16, C_TXT);
    lv_obj_align(s_lbl_info, LV_ALIGN_LEFT_MID, 14, 0);

    lv_obj_t *crs = ui_label(parent, "简约地图 · 离线路网", &ui_cjk_16, 0x5E6B85);
    lv_obj_align(crs, LV_ALIGN_TOP_RIGHT, -10, 16);

    float_btn(parent, "+", 426, 104, 44, 44, 12, 0x111827, C_TXT, &lv_font_montserrat_24,
              zoom_cb, (void *)(intptr_t)1);
    float_btn(parent, "-", 426, 156, 44, 44, 12, 0x111827, C_TXT, &lv_font_montserrat_24,
              zoom_cb, (void *)(intptr_t)-1);

    lv_obj_t *navb = float_btn(parent, "定位 / 导航", 8, 428, 148, 42, 14,
                               0x8B5CF6, C_TXT, &ui_cjk_16, NULL, NULL);
    lv_obj_add_event_cb(navb, nav_main_cb, LV_EVENT_SHORT_CLICKED, NULL);
    lv_obj_add_event_cb(navb, nav_long_cb, LV_EVENT_LONG_PRESSED, NULL);

    lv_obj_t *cal = float_btn(parent, "校准", 382, 428, 90, 42, 14,
                              0x111827, 0xE6EDF7, &ui_cjk_16, calib_open_cb, NULL);
    lv_obj_set_style_border_width(cal, 1, 0);
    lv_obj_set_style_border_color(cal, col(0x2A3550), 0);

    build_nav_modal(parent);
    build_calib_modal(parent);

    if (!s_sem) {
        s_sem = xSemaphoreCreateBinary();
        bt_mgr_set_loc_cb(on_ble_loc);
        BaseType_t ok = xTaskCreateWithCaps(map_task, "map_task", 16384, NULL, 3, NULL,
                                           MALLOC_CAP_SPIRAM);
        ESP_LOGI(TAG, "map task create: %d", (int)ok);
    }

    double clat, clon;
    if (load_calib(&clat, &clon)) {
        s_lat = clat;
        s_lon = clon;
        s_have_fix = true;
        s_manual_fix = true;
        strlcpy(s_place, "我的位置", sizeof(s_place));
    } else {
        request(true, false);
    }
    s_map_dirty = true;
    map_rebuild();
    map_frame();
}

static void tick(void)
{
    if (!s_lbl_info) {
        return;
    }
    if (s_geo_warn) {
        s_geo_warn = false;
        ui_shell_toast(s_route_dist_m > 0 ? "已按示意路线显示" : "未取到地点，先按示意路线显示");
    }
    char buf[96];
    if (s_route_state == 2) {
        snprintf(buf, sizeof(buf), "没找到该地点");
    } else if (s_nav_on && s_route_dist_m > 0) {
        if (s_route_dist_m >= 1000) {
            snprintf(buf, sizeof(buf), "%.1f 公里 · 约 %d 分钟",
                     s_route_dist_m / 1000.0, (s_route_dur_s + 30) / 60);
        } else {
            snprintf(buf, sizeof(buf), "%d 米 · 约 %d 分钟",
                     s_route_dist_m, (s_route_dur_s + 30) / 60);
        }
    } else if (s_nav_on) {
        snprintf(buf, sizeof(buf), "路线已生成（示意）");
    } else if (wifi_mgr_get_state() != WIFI_MGR_CONNECTED) {
        snprintf(buf, sizeof(buf), "无网络 · z%d", s_zoom);
    } else if (!s_have_fix) {
        snprintf(buf, sizeof(buf), "定位中…");
    } else {
        snprintf(buf, sizeof(buf), "%s · z%d", s_place, s_zoom);
    }
    lv_label_set_text(s_lbl_info, buf);
}

static void on_show(void)
{
    ui_shell_set_tick_cb(tick);
    if (!s_anim) {
        s_anim = lv_timer_create(anim_cb, 70, NULL);
    }
    s_map_dirty = true;
    if (!s_have_fix) {
        request(true, false);
    }
}

static void on_hide(void)
{
    ui_shell_set_tick_cb(NULL);
    if (s_anim) {
        lv_timer_delete(s_anim);
        s_anim = NULL;
    }
}

const ui_app_t ui_app_map = {
    .name = "导航",
    .symbol = LV_SYMBOL_GPS,
    .color = 0x1B5E8C,
    .create = create,
    .on_show = on_show,
    .on_hide = on_hide,
};
