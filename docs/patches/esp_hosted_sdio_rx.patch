+static void sdio_read_task(void const* pvParameters)
+{
+	esp_err_t res = ESP_OK;
+	uint8_t *rxbuff = NULL;
+	int ret;
+	uint32_t len_from_slave;
+
+	uint32_t data_left;
+	uint32_t len_to_read;
+	uint8_t *pos;
+	uint32_t interrupts;
+
+#if DO_COMBINED_REG_READ
+	uint32_t *intr_index = NULL;
+#endif
+
