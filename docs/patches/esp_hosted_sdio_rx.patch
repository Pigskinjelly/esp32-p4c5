+/* 【本地补丁 R-30】开机就把流式接收的两块缓冲分配好。
+ * 运行期（摄像头/PPA/编码把内部 DMA 内存占满时）再 malloc 会失败，
+ * 原来直接 assert 重启；现在预分配 + 失败兜底（见 sdio_read_task）。 */
+#define SDIO_RX_PREALLOC_BYTES (8 * 1024)
+
+static void sdio_rx_prealloc(void)
+{
+	for (int i = 0; i < 2; i++) {
+		if (double_buf.buffer[i].buf) {
+			continue;
+		}
+		uint8_t *p = (uint8_t *)g_h.funcs->_h_malloc_align(SDIO_RX_PREALLOC_BYTES,
+		                                                  HOSTED_MEM_ALIGNMENT_64);
+		if (!p) {
+			ESP_LOGW(TAG, "rx prealloc failed (buffer %d)", i);
+			return;
+		}
+		double_buf.buffer[i].buf = p;
+		double_buf.buffer[i].buf_size = SDIO_RX_PREALLOC_BYTES;
+	}
+	ESP_LOGI(TAG, "rx buffers preallocated: 2 x %d B", SDIO_RX_PREALLOC_BYTES);
+}
